# overload-party-gateway のローカル実行用の環境変数。
# `cp .env.example .env` で複製し、必要に応じて値を書き換える。
# Makefile が .env を読み込んで export するため、値は 1 行で書く。

# 必須: 下流サービスの宛先。ポートは README のサービス間連携図に対応する。
BATTLE_SERVER_URL=http://localhost:9002
CARD_SERVICE_URL=http://localhost:9003
MATCHMAKING_SERVICE_URL=http://localhost:9004
ACCOUNT_SERVICE_URL=http://localhost:9005
SHOP_SERVICE_URL=http://localhost:9006
SCENARIO_SERVICE_URL=http://localhost:9007
NEWS_SERVICE_URL=http://localhost:9008
SUPPORT_SERVICE_URL=http://localhost:9009

# 必須: gateway が所有する gateway.game_players の接続先。
DATABASE_CONN=postgresql://postgres:postgres@localhost:5432/gateway?sslmode=disable

# 必須の INTERNAL_AUTH_PRIVATE_KEY はここに書かない。PEM は複数行で .env に載らないため、
# make run-local / make run-gateway が .localdev/ に生成した鍵を環境変数として渡す。

# 任意: コメントを外さなければ括弧内の既定値になる。空文字を代入すると起動時エラーになる。
# PORT=9001
# ENV=dev
# MATCHMAKING_TIMEOUT_SEC=30
# APP_MIN_VERSION=0.1.0
# APP_LATEST_VERSION=0.1.0
# APP_FORCE_UPDATE=false
# APP_STORE_URL=https://example.com/overload-party
# ALLOWED_ORIGINS=http://localhost:5173

# make run-gateway (cmd/main) が要求する。cmd/local は参照しない。
DATABASE_IAM_AUTH_ENABLED=false

# make run-gateway (cmd/main) のみ必須。Google の資格情報 (ADC) も別途要る。
# CLOUDSQL_CONNECTION_NAME=overload-party-dev:asia-northeast1:overload-party
# GOOGLE_CLOUD_PROJECT_ID=overload-party-local
# PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=pubsub-push@overload-party-local.iam.gserviceaccount.com
# PUBSUB_PUSH_AUDIENCE=http://localhost:9001/internal/v1/pubsub/match-made
# UPSTASH_REDIS_URL=redis://localhost:6379
